GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
ENGINEER_LLM_PROVIDER=gemini
ENGINEER_RENDER_TIMEOUT_SECONDS=180
ENGINEER_RENDER_MAX_OUTPUT_TOKENS=9000
WORKFLOW_TIMEOUT_SECONDS=1800

REDIS_URL=redis://localhost:6379/0
REDIS_CHANNEL_PREFIX=launchmind

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BASE_BRANCH=main

SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# Gmail SMTP example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_gmail@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_USE_TLS=true
#
# Use SMTP_PASSWORD, not EMAIL_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

DEMO_STARTUP_IDEA=Negotiation-as-a-Service AI that negotiates salaries, car prices, and service contracts on your behalf by drafting counter-offers, follow-ups, and negotiation strategy.
LOG_LEVEL=INFO
MAX_REVISIONS=2
RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2
CREWAI_VERBOSE=true
